"""
Acciones para crear y activar su entorno virutal en Python
Y configurar las variables de entorno para la conexión a PostgreSQL.
"""
# Crear el entorno
python -m venv .venv

# Activar el entorno (En Windows)
.venv\Scripts\activate

# ENcender el servidor Flask
python app.py